+// The spell wheel (WolkaraRoue) is a ring of spells around the screen's bottom-right corner.
+// The game only lets an add-on turn it in combat from a click or a mouse wheel, so a finger
+// dragged around that ring is sent as wheel notches - one per spell, 18 degrees - with the
+// pointer resting on the spell the finger came down on, where the wheel listens. A tap there
+// is still a tap. On by default in the mobile interface; WolkaraForeverWheelDragV1 = NO
+// turns it off and gives the corner back to the camera.
+static const CGFloat AKWheelStep = 18;
+static const CGFloat AKWheelInner = 0.17, AKWheelOuter = 0.52;   // of the view's height
+static const CGFloat AKWheelFriction = 3.2, AKWheelCoastMin = 45, AKWheelFlick = 90;
+static BOOL AKWheelDragEnabled(void) {
+    id value = [NSUserDefaults.standardUserDefaults objectForKey:@"WolkaraForeverWheelDragV1"];
+    return [value respondsToSelector:@selector(boolValue)] ? [value boolValue] : YES;
+}
+// The tick on each notch follows the touch controls' own Haptics switch.
+static BOOL AKWheelHaptics(void) {
+    NSDictionary *layout = [NSUserDefaults.standardUserDefaults dictionaryForKey:@"WolkaraForeverTouchLayoutV1"];
+    id value = layout[@"hapticsEnabled"];
+    return [value respondsToSelector:@selector(boolValue)] ? [value boolValue] : YES;
+}
+// Degrees around the bottom-right corner: 0 along the bottom edge, 90 up the right edge.
+static CGFloat AKWheelAngle(CGSize size, CGPoint point) {
+    return atan2(size.height - point.y, size.width - point.x) * 180.0 / M_PI;
+}
+static BOOL AKWheelRing(CGSize size, CGPoint point) {
+    CGFloat distance = hypot(size.width - point.x, size.height - point.y);
+    return size.height > 0 && distance >= size.height * AKWheelInner && distance <= size.height * AKWheelOuter;
+}
+// Turn the angle travelled into notches. Turning towards the right edge brings the earlier
+// spells back, which on the wheel is a notch up.
+- (void)spinBy:(CGFloat)degrees {
+    _spinCarry += degrees;
+    while (fabs(_spinCarry) >= AKWheelStep) {
+        CGFloat direction = _spinCarry > 0 ? 1 : -1;
+        _spinCarry -= direction * AKWheelStep;
+        [self postScrollNotch:direction];
+        if (AKWheelHaptics()) { [_spinTick selectionChanged]; [_spinTick prepare]; }
+    }
+}
+- (void)stopWheelCoast { [_spinCoast invalidate]; _spinCoast = nil; }
+- (void)beginWheelSpin {
+    [self cancelDirectHold];
+    _directPending = NO; _directSpin = YES;
+    _spinAngle = AKWheelAngle(self.bounds.size, _directStart);
+    _spinCarry = 0; _spinVelocity = 0; _spinTime = NSProcessInfo.processInfo.systemUptime;
+    if (!_spinTick) _spinTick = [UISelectionFeedbackGenerator new];
+    [_spinTick prepare];
+    AKLog(@"direct touch: drag on the spell wheel turns it");
+}
+- (void)followWheelSpinTo:(CGPoint)point {
+    CGSize size = self.bounds.size;
+    // Too close to the corner the angle means nothing; wait for the finger to come back out.
+    if (hypot(size.width - point.x, size.height - point.y) < size.height * 0.06) return;
+    CGFloat angle = AKWheelAngle(size, point), delta = angle - _spinAngle;
+    _spinAngle = angle;
+    NSTimeInterval now = NSProcessInfo.processInfo.systemUptime, dt = now - _spinTime;
+    _spinTime = now;
+    if (dt > 0.001) _spinVelocity = 0.6 * (delta / dt) + 0.4 * _spinVelocity;
+    [self spinBy:delta];
+}
+// A flick keeps turning after the finger lifts, slowing as the wheel's own coast does.
+- (void)endWheelSpin {
+    _directSpin = NO;
+    NSTimeInterval idle = NSProcessInfo.processInfo.systemUptime - _spinTime;
+    if (idle > 0.08 || fabs(_spinVelocity) < AKWheelFlick) { _spinCarry = 0; return; }
+    [self stopWheelCoast];
+    __block NSTimeInterval last = NSProcessInfo.processInfo.systemUptime, started = last;
+    __weak AKHostView *weakSelf = self;
+    _spinCoast = [NSTimer timerWithTimeInterval:1.0 / 60 repeats:YES block:^(NSTimer *timer) {
+        AKHostView *view = weakSelf;
+        if (!view) { [timer invalidate]; return; }
+        NSTimeInterval now = NSProcessInfo.processInfo.systemUptime, dt = now - last;
+        last = now;
+        [view spinBy:view->_spinVelocity * dt];
+        view->_spinVelocity *= exp(-AKWheelFriction * dt);
+        if (fabs(view->_spinVelocity) < AKWheelCoastMin || now - started > 1.5) {
+            view->_spinCarry = 0; [view stopWheelCoast];
+        }
+    }];
+    [NSRunLoop.mainRunLoop addTimer:_spinCoast forMode:NSRunLoopCommonModes];
+}
 - (BOOL)directGestureActive { return _directTouch != nil || _directMulti; }
 - (void)touchesBegan:(NSSet<UITouch *> *)t withEvent:(UIEvent *)ev {
