     BOOL _directMulti;
     CGFloat _pinchScale, _pinchCarry;
     UIPinchGestureRecognizer *_pinch;
+    // The spell wheel in the bottom-right corner: whether this finger came down on its ring,
+    // whether the drag is turning it, the angle and the part of a notch not yet sent, how fast
+    // it was turning, and the coast that carries a flick on after the finger lifts.
+    BOOL _spinCandidate, _directSpin;
+    CGFloat _spinAngle, _spinCarry, _spinVelocity;
+    NSTimeInterval _spinTime;
+    NSTimer *_spinCoast;
+    UISelectionFeedbackGenerator *_spinTick;
 }
 - (BOOL)ak_needsTrackingEvents { return _touchControls.configuring || _touchControls.keyboardVisible || _pressedLeft || _pressedRight || _pressedMiddle; }
 - (instancetype)initWithFrame:(CGRect)f {
@@ -706,6 +714,7 @@ static BOOL AKIsFinger(NSSet<UITouch *> *t) { return t.anyObject.type == UITouch
 - (void)beginDirectMulti {
     [self cancelDirectHold];
     _directPending = NO; _directHeld = NO; _directMulti = YES;
+    _directSpin = NO; [self stopWheelCoast];
     if (_pressedLeft) [self postMouse:NSEventTypeLeftMouseUp at:_last button:0];
     if (_pressedRight) [self postMouse:NSEventTypeRightMouseUp at:_last button:1];
 }
@@ -737,6 +746,86 @@ static BOOL AKIsFinger(NSSet<UITouch *> *t) { return t.anyObject.type == UITouch
